# Copy to .env and fill in your own values. Never commit .env.
# NVIDIA NIM (OpenAI-compatible) -- key from build.nvidia.com
OPENAI_API_KEY=your-nvidia-nim-key
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b
# Tavily search -- key from app.tavily.com
TAVILY_API_KEY=your-tavily-key
# Only needed by deploy.sh
GCP_PROJECT_ID=your-gcp-project-id
